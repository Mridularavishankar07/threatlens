PORT=5000
MONGO_URI=mongodb://localhost:27017/threatlens
JWT_SECRET=threatlens_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
NODE_ENV=development
# Optional: External threat intelligence API
THREAT_INTELLIGENCE_API_KEY=
# Optional: Google Gemini AI API key for Hybrid AI Phishing Detection
GEMINI_API_KEY=your_gemini_api_key_here
# Risk score thresholds
SAFE_THRESHOLD=29
SUSPICIOUS_THRESHOLD=59
# Analysis weights (must sum to 100)
WEIGHT_SENDER=20
WEIGHT_URL=25
WEIGHT_CONTENT=25
WEIGHT_SOCIAL_ENGINEERING=15
WEIGHT_CREDENTIAL_FINANCIAL=15
